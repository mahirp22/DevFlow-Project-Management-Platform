# Public configuration only. Never place secrets in VITE_* variables.
# The Vite development proxy forwards /api to the local backend.
VITE_API_BASE_URL=/api
# Public Cognito configuration; set all three in .env.local after creating the pool.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
